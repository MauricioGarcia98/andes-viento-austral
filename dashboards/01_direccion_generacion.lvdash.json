{
  "datasets": [
    {
      "name": "monthly",
      "displayName": "Real vs presupuesto mensual",
      "queryLines": [
        "SELECT park_name, technology, month_start, year_month, actual_mwh, budget_p50_mwh, variance_pct,\n",
        "       lost_curtailment_mwh, lost_fault_mwh, lost_maintenance_mwh, lost_icing_mwh, lost_soiling_mwh, resource_effect_mwh\n",
        "FROM gold.mart_generation_vs_budget\n"
      ]
    },
    {
      "name": "last12",
      "displayName": "Últimos 12 meses",
      "queryLines": [
        "SELECT sum(actual_mwh) AS actual_mwh, sum(budget_p50_mwh) AS budget_mwh,\n",
        "       sum(actual_mwh) / sum(budget_p50_mwh) - 1 AS variance_pct,\n",
        "       sum(lost_curtailment_mwh) AS curtailment_mwh\n",
        "FROM gold.mart_generation_vs_budget\n",
        "WHERE month_start > add_months((SELECT max(month_start) FROM gold.mart_generation_vs_budget), -12)\n"
      ]
    },
    {
      "name": "losses_last",
      "displayName": "Pérdidas del último mes por parque",
      "queryLines": [
        "SELECT park_name, causa, mwh FROM (\n",
        "  SELECT park_name, lost_curtailment_mwh AS curtailment, lost_fault_mwh AS fallas, lost_maintenance_mwh AS mantenimiento,\n",
        "         lost_icing_mwh AS hielo, lost_soiling_mwh AS suciedad\n",
        "  FROM gold.mart_generation_vs_budget\n",
        "  WHERE month_start = (SELECT max(month_start) FROM gold.mart_generation_vs_budget)\n",
        ") UNPIVOT (mwh FOR causa IN (curtailment, fallas, mantenimiento, hielo, suciedad))\n"
      ]
    }
  ],
