{
  "datasets": [
    {
      "name": "risk_now",
      "displayName": "Turbinas en riesgo hoy",
      "queryLines": [
        "SELECT * FROM gold.fn_turbinas_en_riesgo(NULL)\n"
      ]
    },
    {
      "name": "health",
      "displayName": "Salud diaria",
      "queryLines": [
        "SELECT reading_date, park_code, turbine_id, health_score, gearbox_residual_7d, vibration_ratio, risk_level,\n",
        "       failure_within_30d\n",
        "FROM gold.mart_turbine_health WHERE reading_date >= date_sub((SELECT max(reading_date) FROM gold.mart_turbine_health), 120)\n"
      ]
    },
    {
      "name": "lead",
      "displayName": "Anticipación de las alertas",
      "queryLines": [
        "WITH f AS (SELECT DISTINCT turbine_id, next_major_failure_date FROM gold.mart_turbine_health\n",
        "           WHERE next_major_failure_date IS NOT NULL)\n",
        "SELECT f.turbine_id, f.next_major_failure_date,\n",
        "       max(datediff(f.next_major_failure_date, h.reading_date)) AS dias_de_anticipacion\n",
        "FROM f LEFT JOIN gold.mart_turbine_health h ON h.turbine_id = f.turbine_id AND h.risk_level = 'ALTO'\n",
        "  AND h.reading_date BETWEEN date_sub(f.next_major_failure_date, 45) AND date_sub(f.next_major_failure_date, 1)\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "orders",
      "displayName": "Órdenes correctivas mayores",
      "queryLines": [
        "SELECT date_format(created_date, 'yyyy-MM') AS year_month, component, count(*) AS ordenes,\n",
        "       avg(downtime_hours) AS horas_parada, sum(total_cost_usd) AS costo_usd\n",
        "FROM gold.fact_maintenance_order WHERE order_type = 'CORRECTIVA' AND severity = 'MAYOR' GROUP BY ALL\n"
      ]
    }
  ],
  "pages": [
