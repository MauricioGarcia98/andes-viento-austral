{
  "datasets": [
    {
      "name": "monthly",
      "displayName": "Curtailment mensual",
      "queryLines": [
        "SELECT p.park_name, date_format(f.reading_date, 'yyyy-MM') AS year_month, trunc(f.reading_date, 'MM') AS month_start,\n",
        "       sum(f.lost_curtailment_mwh) AS curtailed_mwh, sum(f.potential_mwh) AS potential_mwh,\n",
        "       sum(f.lost_value_spot_usd) AS value_spot_usd, count_if(f.has_instruction) AS hours_with_order\n",
        "FROM gold.fact_curtailment_hourly f JOIN gold.dim_park p USING (park_key)\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "hour_profile",
      "displayName": "Perfil horario",
      "queryLines": [
        "SELECT hour(hour_local) AS hora_local, sum(lost_curtailment_mwh) AS curtailed_mwh, avg(spot_usd_mwh) AS spot_usd_mwh\n",
        "FROM gold.fact_curtailment_hourly GROUP BY 1\n"
      ]
    },
    {
      "name": "battery",
      "displayName": "Ranking de baterías (12 meses)",
      "queryLines": [
        "SELECT * FROM gold.fn_ranking_baterias(12)\n"
      ]
    }
  ],
  "pages": [
    {
      "name": "curtailment",
