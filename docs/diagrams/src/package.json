{
  "name": "andes-diagrams",
  "private": true,
  "type": "module",
  "description": "Exporta los .excalidraw a SVG/PNG/GIF con la librer\u00eda oficial de Excalidraw en Chromium headless",
  "scripts": {
    "bundle": "esbuild entry.js --bundle --format=esm --outfile=bundle.js --define:process.env.NODE_ENV=\\\"production\\\" --log-level=warning",
    "render": "node render.mjs ../01_arquitectura.excalidraw ../01_arquitectura"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1"
  }
}
